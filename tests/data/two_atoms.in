units           real
atom_style      bond
boundary        p p p

region          box block 0 10 0 10 0 10
create_box      1 box bond/types 1 extra/bond/per/atom 1 extra/special/per/atom 2
create_atoms    1 single 4.5 5.0 5.0
create_atoms    1 single 5.5 5.0 5.0
mass            1 1.008

pair_style      zero 5.0
pair_coeff      * *
bond_style      harmonic
bond_coeff      1 100.0 1.0
create_bonds    single/bond 1 1 2

# Give the atoms something to do, so two frames are never identical.
velocity        all create 300.0 4928459 dist gaussian
fix             nve all nve
timestep        0.5
